# /etc/ffhub/env — root:ffhub 0640. Never commit this file.
#
# Only the FastAPI variant (app/, on a VPS) reads this file. The Cloudflare
# Worker takes FREE_FIRE_API_KEY from Sites → Secrets instead: there is no
# backend to proxy to, so there is no BACKEND_URL and no HUB_TOKEN there.

FREE_FIRE_API_KEY=replace-me
# Bearer this API requires; anything calling it directly must send it.
FFHUB_TOKEN=replace-me

# Provider base, if it is not the default.
FIRE_API_BASE=https://developers.freefirecommunity.com/api/v1

FFHUB_DATA_DIR=/var/lib/ffhub
FFHUB_CATALOG_DIR=/var/lib/ffhub/catalog
FFHUB_EXPORTER_VERSION=1
FFHUB_CATALOG_VERSION=1

FFHUB_REQUEST_TIMEOUT=20
FFHUB_PROVIDER_ATTEMPTS=3
FFHUB_MAX_GLB_BYTES=268435456
