<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      The App Group belongs to this app's own team prefix and must be enabled
      for the bundle identifier in the provisioning profile — a wildcard
      profile cannot carry it. The app resolves patch, backup and workspace
      containers through its own data container and this group only.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.cc.forcequit.worse-query</string>
    </array>
</dict>
</plist>
