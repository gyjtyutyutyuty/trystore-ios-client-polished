<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      worse_query needs an App Group on iOS 26.7 and later. The value here is
      a placeholder: the signing tool creates its own group and re-signs the
      app, and worse_query reads whichever group it receives at runtime via
      SecTaskCopyValueForEntitlement. A wildcard profile cannot carry this.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.apple.mobile.MobileHouseArrest</string>
    </array>
</dict>
</plist>
